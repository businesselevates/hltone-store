{%- liquid
  assign product = section.settings.product
  assign prefix = section.settings.price_prefix
  assign anchor = section.settings.anchor_id | default: 'hlt-buy-box'
  assign age_blocks = section.blocks | where: 'type', 'age'
  assign first_age = age_blocks.first
-%}

{%- capture bundle_json -%}
{
  "addLabel": {{ section.settings.add_label | json }},
  "soldOutLabel": {{ section.settings.sold_out_label | json }},
  "ages": [
    {%- for age in age_blocks -%}
      {%- liquid
        assign v_std = nil
        assign v_val = nil
        if product != blank
          for v in product.variants
            if v.option1 == age.settings.option_value and v.option2 == section.settings.standard_value
              assign v_std = v
            endif
            if v.option1 == age.settings.option_value and v.option2 == section.settings.value_value
              assign v_val = v
            endif
          endfor
        endif
      -%}
      {
        "key": {{ age.id | json }},
        "standard": {
          "id": {% if v_std %}{{ v_std.id }}{% else %}null{% endif %},
          "available": {% if v_std %}{{ v_std.available }}{% else %}false{% endif %},
          "price": {% if v_std %}{{ v_std.price | money_without_currency | json }}{% else %}{{ age.settings.fallback_standard | json }}{% endif %}
        },
        "value": {
          "id": {% if v_val %}{{ v_val.id }}{% else %}null{% endif %},
          "available": {% if v_val %}{{ v_val.available }}{% else %}false{% endif %},
          "price": {% if v_val %}{{ v_val.price | money_without_currency | json }}{% else %}{{ age.settings.fallback_value | json }}{% endif %}
        }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}

<section
  id="{{ anchor }}"
  class="hlt hlt--{{ section.settings.background }} hlt-bb"
  style="--hlt-pt: {{ section.settings.padding_top }}px; --hlt-pb: {{ section.settings.padding_bottom }}px;"
  data-hlt-buy-box
  tabindex="-1"
>
  <script type="application/json" data-hlt-bundle-data>{{ bundle_json }}</script>

  <div class="hlt__inner hlt-bb__grid">
    {%- comment -%} ---------------- Title block ----------------
      Sits above the gallery on phones and beside it on desktop (see the
      grid areas in hlt-buy-box.css). {%- endcomment -%}
    <div class="hlt-bb__head hlt-stack" style="--hlt-gap: 12px;" data-hlt-reveal="right">
    <div class="hlt-stack" style="--hlt-gap: 12px;">
      {%- if section.settings.show_rating or section.settings.show_badge2 -%}
        <ul class="hlt-bb__pills">
          {%- if section.settings.show_rating -%}
            <li class="hlt-bb__pill">
              <span class="hlt-bb__pill-stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- if i <= section.settings.rating_value -%}
                    {% render 'hlt-icon', name: 'star', size: 15 %}
                  {%- else -%}
                    <span class="is-empty">{% render 'hlt-icon', name: 'star', size: 15 %}</span>
                  {%- endif -%}
                {%- endfor -%}
              </span>
              {%- if section.settings.rating_text != blank -%}<span>{{ section.settings.rating_text }}</span>{%- endif -%}
            </li>
          {%- endif -%}
          {%- if section.settings.show_badge2 and section.settings.badge2_text != blank -%}
            <li class="hlt-bb__pill">{{ section.settings.badge2_text }}</li>
          {%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}<p class="hlt-overline">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="hlt-h2 hlt-bb__title" style="--hlt-title-size: {{ section.settings.title_size }}px;">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="hlt-body">{{ section.settings.body }}</div>{%- endif -%}
    </div>

    {%- assign tag_blocks = section.blocks | where: 'type', 'tag' -%}
    {%- if tag_blocks.size > 0 -%}
      <ul class="hlt-tags">
        {%- for tag in tag_blocks -%}
          {%- if tag.settings.text != blank -%}
            <li class="hlt-tag" {{ tag.shopify_attributes }}>{% render 'hlt-icon', name: tag.settings.icon, size: 17 %}{{ tag.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- assign tags = section.settings.tags | split: '|' -%}
      {%- if tags.size > 0 -%}
        <ul class="hlt-tags">
          {%- for t in tags -%}
            {%- assign tt = t | strip -%}
            {%- if tt != blank -%}<li class="hlt-tag">{% render 'hlt-icon', name: 'check', size: 17 %}{{ tt }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
    </div>

    {%- comment -%} ---------------- Gallery ---------------- {%- endcomment -%}
    <div class="hlt-bb__gallery" data-hlt-gallery data-hlt-reveal="left">
      <div class="hlt-bb__stage">
        <div class="hlt-bb__track" data-hlt-gallery-track>
          {%- if section.settings.age_image_first -%}
            {%- for age in age_blocks -%}
              <figure class="hlt-bb__slide" data-hlt-slide="age-{{ age.id }}" data-hlt-age-only="{{ age.id }}"{% unless forloop.first %} hidden{% endunless %}>
                <div class="hlt-media" style="--hlt-ratio: 1 / 1;">
                  {%- if age.settings.image != blank -%}
                    {{ age.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'hlt-placeholder' }}
                  {%- endif -%}
                </div>
                {%- if age.settings.image_text_standard != blank -%}
                  <figcaption class="hlt-bb__caption" data-hlt-size-only="standard" data-hlt-age-only="{{ age.id }}">{{ age.settings.image_text_standard }}</figcaption>
                {%- endif -%}
                {%- if age.settings.image_text_value != blank -%}
                  <figcaption class="hlt-bb__caption" data-hlt-size-only="value" data-hlt-age-only="{{ age.id }}" hidden>{{ age.settings.image_text_value }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endfor -%}
          {%- endif -%}

          {%- assign hlt_tile_n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.show -%}
              {%- liquid
                assign hlt_tile_n = hlt_tile_n | plus: 1
                assign caption = block.settings.image_text
                if block.settings.use_pending_text and block.settings.pending_text != blank
                  assign caption = block.settings.pending_text
                endif
              -%}
              <figure
                class="hlt-bb__slide{% if block.settings.style == 'quote' %} hlt-bb__slide--quote{% endif %}{% if hlt_tile_n > 4 %} hlt-bb__slide--extra{% endif %}"
                data-hlt-slide="{{ block.id }}"
                {% if block.settings.only_for == 'value' %}data-hlt-size-only="value" hidden{% endif %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.style == 'quote' -%}
                  <div class="hlt-media hlt-bb__quote" style="--hlt-ratio: 1 / 1;">
                    <div class="hlt-bb__quote-inner">
                      <span class="hlt-bb__stars" aria-hidden="true">✦</span>
                      <p class="hlt-bb__quote-text">{{ caption }}</p>
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 400 | image_tag: class: 'hlt-bb__quote-img', loading: 'lazy' }}
                      {%- endif -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="hlt-media" style="--hlt-ratio: 1 / 1;">
                    {%- if block.settings.video != blank -%}
                      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x' }}
                    {%- elsif block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
                    {%- else -%}
                      {{ 'product-2' | placeholder_svg_tag: 'hlt-placeholder' }}
                    {%- endif -%}
                  </div>
                  {%- if caption != blank -%}<figcaption class="hlt-bb__caption">{{ caption }}</figcaption>{%- endif -%}
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="hlt-bb__dots" data-hlt-dots aria-hidden="true"></div>
      </div>

      <div class="hlt-bb__thumbs" role="list">
        {%- if section.settings.age_image_first -%}
          {%- for age in age_blocks -%}
            <button type="button" class="hlt-bb__thumb" role="listitem" data-hlt-thumb="age-{{ age.id }}" data-hlt-age-only="{{ age.id }}"{% unless forloop.first %} hidden{% endunless %} aria-label="Image {{ forloop.index }}">
              {%- if age.settings.image != blank -%}{{ age.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hlt-placeholder' }}{%- endif -%}
            </button>
          {%- endfor -%}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' and block.settings.show -%}
            <button type="button" class="hlt-bb__thumb{% if block.settings.style == 'quote' %} hlt-bb__thumb--quote{% endif %}" role="listitem" data-hlt-thumb="{{ block.id }}" {% if block.settings.only_for == 'value' %}data-hlt-size-only="value" hidden{% endif %} aria-label="Image">
              {%- if block.settings.style == 'quote' -%}
                <span aria-hidden="true">“ ”</span>
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag: 'hlt-placeholder' }}
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---------------- Buy box ---------------- {%- endcomment -%}
    <div class="hlt-bb__panel" data-hlt-reveal="right">
      <div class="hlt-bb__panel-inner hlt-stack" style="--hlt-gap: 26px;">
        {%- if product == blank and request.design_mode -%}
          <p class="hlt-bb__notice">Pick the bundle product in this section's settings so "Add to cart" works.</p>
        {%- endif -%}

        <div class="hlt-bb__group">
          <p class="hlt-bb__label">{{ section.settings.age_label }}</p>
          <div class="hlt-bb__chips" role="group" aria-label="{{ section.settings.age_label | escape }}">
            {%- for age in age_blocks -%}
              <button type="button" class="hlt-bb__chip" data-hlt-age="{{ age.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ age.shopify_attributes }}>
                {%- assign chip_parts = age.settings.chip_label | split: ',' -%}
                <strong>{{ chip_parts.first | strip }}</strong>
                {%- if chip_parts.size > 1 -%}<span>{{ age.settings.chip_label | remove_first: chip_parts.first | remove_first: ',' | strip }}</span>{%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="hlt-bb__group">
          <p class="hlt-bb__label">{{ section.settings.bundle_label }}</p>
          <div class="hlt-bb__cards" role="radiogroup" aria-label="{{ section.settings.bundle_label | escape }}">
            {%- for size in (1..2) -%}
              {%- liquid
                if size == 1
                  assign size_key = 'standard'
                  assign card_title = section.settings.card1_title
                  assign card_tag = section.settings.card1_tag
                  assign bullets = section.settings.card1_bullets | newline_to_br | split: '<br />'
                else
                  assign size_key = 'value'
                  assign card_title = section.settings.card2_title
                  assign card_tag = section.settings.card2_tag
                  assign bullets = section.settings.card2_bullets | newline_to_br | split: '<br />'
                endif
              -%}
              <div class="hlt-bb__card{% if size == 1 %} is-selected{% endif %}" role="radio" tabindex="0" data-hlt-size="{{ size_key }}" aria-checked="{% if size == 1 %}true{% else %}false{% endif %}">
                {%- if card_tag != blank -%}<span class="hlt-bb__card-tag">{{ card_tag }}</span>{%- endif -%}
                <span class="hlt-bb__radio" aria-hidden="true"></span>
                <div class="hlt-bb__card-head">
                  <div>
                    <p class="hlt-h4">{{ card_title }}</p>
                    {%- for age in age_blocks -%}
                      <p class="hlt-bb__card-line" data-hlt-age-only="{{ age.id }}"{% unless forloop.first %} hidden{% endunless %}>{% if size == 1 %}{{ age.settings.card1_line }}{% else %}{{ age.settings.card2_line }}{% endif %}</p>
                    {%- endfor -%}
                  </div>
                  <div class="hlt-bb__card-price">
                    {%- for age in age_blocks -%}
                      <div data-hlt-age-only="{{ age.id }}"{% unless forloop.first %} hidden{% endunless %}>
                        <p class="hlt-bb__price">{% if size == 1 %}{{ age.settings.card1_price }}{% else %}{{ age.settings.card2_price }}{% endif %}</p>
                        <p class="hlt-bb__per">{% if size == 1 %}{{ age.settings.card1_per }}{% else %}{{ age.settings.card2_per }}{% endif %}</p>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
                <ul class="hlt-bb__bullets">
                  {%- for age in age_blocks -%}
                    <li data-hlt-age-only="{{ age.id }}"{% unless forloop.first %} hidden{% endunless %}>{% if size == 1 %}{{ age.settings.card1_first_bullet }}{% else %}{{ age.settings.card2_first_bullet }}{% endif %}</li>
                  {%- endfor -%}
                  {%- for b in bullets -%}
                    {%- assign bb = b | strip -%}
                    {%- if bb != blank -%}<li>{{ bb }}</li>{%- endif -%}
                  {%- endfor -%}
                  {%- if size == 2 and section.settings.show_gift and section.settings.gift_bullet != blank -%}
                    <li class="hlt-bb__gift">{% render 'hlt-icon', name: 'gift', size: 18 %}{{ section.settings.gift_bullet }}</li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="hlt-stack" style="--hlt-gap: 14px;">
          <button type="button" class="hlt-btn hlt-btn--block hlt-bb__add" data-hlt-add-bundle>
            <span><span data-hlt-btn-label>{{ section.settings.add_label }}</span><span class="hlt-bb__add-price" data-hlt-price-wrap>, {{ prefix }}<span data-hlt-btn-price>{{ first_age.settings.fallback_standard }}</span></span></span>
          </button>
          <p class="hlt-bb__error" role="alert" data-hlt-error hidden></p>

          {%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
          {%- assign badge_cols = badge_blocks.size -%}
          {%- if badge_cols > 5 -%}{%- assign badge_cols = 5 -%}{%- endif -%}
          {%- if badge_cols < 1 -%}{%- assign badge_cols = 1 -%}{%- endif -%}
          <ul class="hlt-badges hlt-bb__badges" style="--hlt-badge-cols: {{ badge_cols }};">
            {%- for block in badge_blocks -%}
              <li class="hlt-badge" {{ block.shopify_attributes }}>
                <span class="hlt-bb__badge-ring">
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 80 | image_tag: class: 'hlt-bb__badge-logo', loading: 'lazy' }}
                  {%- else -%}
                    {% render 'hlt-icon', name: block.settings.icon, size: 24 %}
                  {%- endif -%}
                </span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="hlt-bb__dropdowns">
          {%- for block in section.blocks -%}
            {%- if block.type == 'dropdown' -%}
              <details class="hlt-acc" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }}<span class="hlt-acc__icon" aria-hidden="true"></span></summary>
                <div class="hlt-acc__body">
                  <div class="hlt-acc__content hlt-body">
                    {{ block.settings.text }}
                    {%- if block.settings.show_pending and block.settings.pending_text != blank -%}{{ block.settings.pending_text }}{%- endif -%}
                    {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                      <p><a class="hlt-bb__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }} {% render 'hlt-icon', name: 'arrow-right', size: 16 %}</a></p>
                    {%- endif -%}
                  </div>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- if section.settings.sticky_bar and age_blocks.size > 0 -%}
  <div class="hlt hlt-sticky" data-hlt-sticky-bar aria-hidden="true">
    <div class="hlt-sticky__inner">
      <label class="hlt-sticky__field">
        <span class="visually-hidden">{{ section.settings.age_label }}</span>
        <select data-hlt-sticky-age>
          {%- for age in age_blocks -%}<option value="{{ age.id }}">{{ age.settings.chip_label }}</option>{%- endfor -%}
        </select>
      </label>
      <label class="hlt-sticky__field">
        <span class="visually-hidden">{{ section.settings.bundle_label }}</span>
        <select data-hlt-sticky-size>
          <option value="standard">{{ section.settings.card1_title }}</option>
          <option value="value">{{ section.settings.card2_title }}</option>
        </select>
      </label>
      <button type="button" class="hlt-btn hlt-sticky__btn" data-hlt-sticky-add>
        <span><span data-hlt-sticky-label>{{ section.settings.add_label }}</span></span>
      </button>
      <p class="hlt-bb__error hlt-sticky__error" role="alert" data-hlt-error hidden></p>
    </div>
  </div>

  <script>
    (function () {
      var bar = document.querySelector('[data-hlt-sticky-bar]');
      var box = document.querySelector('[data-hlt-buy-box]');
      if (!bar || !box || bar.hltReady) return;
      bar.hltReady = true;

      var data = {};
      try { data = JSON.parse(box.querySelector('[data-hlt-bundle-data]').textContent) || {}; } catch (e) {}

      var ageSel = bar.querySelector('[data-hlt-sticky-age]');
      var sizeSel = bar.querySelector('[data-hlt-sticky-size]');
      var price = bar.querySelector('[data-hlt-sticky-price]');
      var btn = bar.querySelector('[data-hlt-sticky-add]');
      var label = bar.querySelector('[data-hlt-sticky-label]');
      var wrap = btn ? btn.querySelector('[data-hlt-price-wrap]') : null;
      var err = bar.querySelector('[data-hlt-error]');

      var onChange = function (e) {
        var d = e.detail || {};
        var v = d.variant || {};
        if (ageSel && d.age) ageSel.value = d.age;
        if (sizeSel && d.size) sizeSel.value = d.size;
        if (price) price.textContent = v.price || '';
        if (btn) {
          var off = !v.id || v.available === false;
          btn.disabled = off;
          btn.setAttribute('data-variant-id', v.id || '');
          if (label) label.textContent = off ? (data.soldOutLabel || 'Sold out') : (data.addLabel || 'Add to cart');
          if (wrap) wrap.hidden = off;
        }
      };
      document.addEventListener('hlt:bundle-change', onChange);

      if (ageSel) ageSel.addEventListener('change', function () { if (box.hltSet) box.hltSet(ageSel.value, null); });
      if (sizeSel) sizeSel.addEventListener('change', function () { if (box.hltSet) box.hltSet(null, sizeSel.value); });
      if (btn) {
        btn.addEventListener('click', function () {
          if (window.HLT && window.HLT.addToCart) window.HLT.addToCart(btn.getAttribute('data-variant-id'), btn, err);
        });
      }

      function syncNow() {
        if (box.hltState) document.dispatchEvent(new CustomEvent('hlt:bundle-change', { detail: box.hltState() }));
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncNow);
      else setTimeout(syncNow, 0);

      /* Visible from the moment the page loads, and hidden only while the real
         Add to cart button is on screen. */
      var target = box.querySelector('[data-hlt-add-bundle]');
      var observer = null;
      function show(on) {
        bar.classList.toggle('is-visible', on);
        bar.setAttribute('aria-hidden', on ? 'false' : 'true');
        document.body.classList.toggle('hlt-sticky-on', on);
      }
      if (target && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver(function (entries) {
          show(!entries[0].isIntersecting);
        }, { threshold: 0, rootMargin: '0px 0px -96px 0px' });
        observer.observe(target);
      } else {
        show(true);
      }

      document.addEventListener('shopify:section:unload', function cleanup() {
        if (bar.isConnected) return;
        document.removeEventListener('hlt:bundle-change', onChange);
        if (observer) observer.disconnect();
        document.removeEventListener('shopify:section:unload', cleanup);
        document.body.classList.remove('hlt-sticky-on');
      });
    })();
  </script>
{%- endif -%}

{{ 'hlt-buy-box.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "HLT Gallery and buy box",
  "tag": "div",
  "class": "hlt-section",
  "max_blocks": 40,
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Bundle product", "info": "The product with an age option (first) and a size option (second)." },
    { "type": "text", "id": "standard_value", "label": "Size option value for Standard", "default": "Standard" },
    { "type": "text", "id": "value_value", "label": "Size option value for Value pack", "default": "Value Pack" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "S$" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Buttons elsewhere scroll to #this-id.", "default": "hlt-buy-box" },
    { "type": "checkbox", "id": "age_image_first", "label": "Show each age's bundle image first in the gallery", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add-to-cart bar", "info": "Shows from the moment the page loads and hides only while the main Add to cart button is on screen.", "default": true },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show the star rating line", "info": "Turn on once there is a rating to claim.", "default": false },
    { "type": "range", "id": "rating_value", "label": "Stars filled", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 average from Singapore parents" },
    { "type": "checkbox", "id": "show_badge2", "label": "Show the second pill", "info": "Turn on once there is a claim to put in it.", "default": false },
    { "type": "text", "id": "badge2_text", "label": "Second pill text", "info": "For example a bestseller or award line." },
    { "type": "header", "content": "Text" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show the eyebrow line", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Sits above the title. Use it for a tagline, or turn it off.", "default": "Yummybara by HLT One" },
    { "type": "text", "id": "title", "label": "Title", "default": "Yummybara Age Bundle" },
