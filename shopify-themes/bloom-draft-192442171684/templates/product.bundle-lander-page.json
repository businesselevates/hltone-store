      "blocks": {
        "body_2": {
          "settings": {
            "large": true,
            "text": "<p>Three questions decide it. Can your child eat it easily at the age they are now? Are you happy with what is in it? Will it still be good when you open it at four in the afternoon?</p>"
          },
          "type": "body"
        },
        "body_3": {
          "settings": {
            "large": true,
            "text": "<p><strong>Yummybara was made to answer yes to all three.</strong></p>"
