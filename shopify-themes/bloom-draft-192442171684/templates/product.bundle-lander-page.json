    "hlt_problem": {
      "block_order": [
        "heading_1",
        "body_2",
        "body_3",
        "body_4"
      ],
      "blocks": {
        "body_2": {
          "settings": {
            "large": true,
            "text": "<p>Parents in Singapore say it plainly: \"These are basically junk food tbh but they have their uses.\" You pack them anyway, because a hungry toddler halfway round the zoo will not wait.</p>"
          },
          "type": "body"
        },
        "body_3": {
          "settings": {
            "large": true,
            "text": "<p>Then the open bag rolls around at the bottom of the stroller, goes soft, and ends up in the bin. One parent put it this way: other brands \"always got wasted because they couldn't keep.\"</p>"
          },
          "type": "body"
        },
        "body_4": {
          "settings": {
            "large": true,
            "text": "<p><strong>The fault sits with the snack you had to settle for, not with you.</strong></p>"
          },
          "type": "body"
        },
        "heading_1": {
          "settings": {
            "size": "hlt-h2",
            "text": "Most snacks packed for a day out are a compromise."
          },
          "type": "heading"
        }
      },
