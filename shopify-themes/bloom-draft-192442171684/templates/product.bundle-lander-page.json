      ],
      "blocks": {
        "review_1": {
          "settings": {
            "lead_for": "0",
            "name": "",
            "tag": "",
            "text": "I've been ordering this almost every other week with the rate my toddler is going. It's one of her almost-daily snacks! Fast delivery as always."
          },
          "type": "review"
        },
        "review_2": {
          "settings": {
            "lead_for": "1",
            "name": "",
            "tag": "",
            "text": "Tastes good even for adults, not too sweet, and melts in the mouth. Baby loves it so much that I had to find it online!"
          },
          "type": "review"
        },
        "review_3": {
          "settings": {
            "lead_for": "3",
            "name": "",
            "tag": "",
            "text": "These are so good and so crunchy! My baby absolutely adores them and just can't get enough. Definitely recommend."
          },
          "type": "review"
        },
        "review_4": {
          "settings": {
            "lead_for": "0",
            "name": "",
            "tag": "",
            "text": "Easy for a 1-year-old to eat, with no ingredients other than the fruit itself."
          },
          "type": "review"
        },
        "review_5": {
          "settings": {
            "lead_for": "0",
            "name": "",
            "tag": "",
            "text": "He loves it, and it stays crispy even when it's been opened for days, unlike other brands we'd tried, which always got wasted because they couldn't keep."
          },
          "type": "review"
        },
        "review_6": {
          "settings": {
            "lead_for": "0",
            "name": "",
            "tag": "",
            "text": "Trust me, my house only has HLT One snacks now. No more other biscuits. We used to buy fish or animal biscuits and ended up stopping. We changed everything to HLT."
          },
          "type": "review"
        }
      },
