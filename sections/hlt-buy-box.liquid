{% schema %}
{
  "name": "HLT Gallery and buy box",
  "tag": "div",
  "class": "hlt-section",
  "max_blocks": 40,
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Bundle product", "info": "The product with an age option (first) and a size option (second)." },
    { "type": "text", "id": "standard_value", "label": "Size option value for Standard", "default": "Standard" },
    { "type": "text", "id": "value_value", "label": "Size option value for Value pack", "default": "Value Pack" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "S$" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Buttons elsewhere scroll to #this-id.", "default": "hlt-buy-box" },
    { "type": "checkbox", "id": "age_image_first", "label": "Show each age's bundle image first in the gallery", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Gallery 'View all' label", "info": "Shown on desktop when there are more than 4 gallery images under the main image.", "default": "View all" },
    { "type": "text", "id": "view_less_label", "label": "Gallery 'View less' label", "default": "View less" },
    { "type": "checkbox", "id": "tile_captions", "label": "Show text on the smaller gallery images", "info": "The main bundle image always keeps its text.", "default": false },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add-to-cart bar", "info": "Shows from the moment the page loads and hides only while the main Add to cart button is on screen.", "default": true },
    { "type": "header", "content": "Pair it with" },
    { "type": "paragraph", "content": "Add-ons shown under the buy box, one per view with dots. Add them as 'Pair: product' and 'Pair: next age bundle' blocks. They use the price prefix and Add to cart label above." },
    { "type": "text", "id": "pair_heading", "label": "Tab 1 label (add-on products)", "default": "Pair it with" },
    { "type": "text", "id": "pair_next_tab", "label": "Tab 2 label (next age bundle)", "default": "The next age bundle" },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show the star rating line", "info": "Turn on once there is a rating to claim.", "default": false },
    { "type": "range", "id": "rating_value", "label": "Stars filled", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 average from Singapore parents" },
    { "type": "checkbox", "id": "show_badge2", "label": "Show the second pill", "info": "Turn on once there is a claim to put in it.", "default": false },
    { "type": "text", "id": "badge2_text", "label": "Second pill text", "info": "For example a bestseller or award line." },
    { "type": "header", "content": "Text" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show the eyebrow line", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Sits above the title. Use it for a tagline, or turn it off.", "default": "Yummybara by HLT One" },
    { "type": "text", "id": "title", "label": "Title", "default": "Yummybara Age Bundle" },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 36, "info": "Lower this until the title sits on one line." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Snacks you can hand over anywhere: made for your child's age, with no added refined sugar or salt, in snack-sized packs sealed one by one.</p>" },
    { "type": "text", "id": "tags", "label": "Tags", "info": "Only used when there are no Benefit tag blocks. Separate with |.", "default": "Easy for little mouths | No added sugar or salt | Sealed one by one" },
    { "type": "text", "id": "age_label", "label": "Age label", "default": "Pick your child's age" },
    { "type": "text", "id": "bundle_label", "label": "Bundle label", "default": "Pick your bundle" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "header", "content": "Card 1 (Standard)" },
    { "type": "text", "id": "card1_title", "label": "Title", "default": "Standard" },
    { "type": "text", "id": "card1_tag", "label": "Corner tag" },
    { "type": "textarea", "id": "card1_bullets", "label": "Bullets after the age bullet", "info": "One per line", "default": "About two months of one snack a day\nFree delivery" },
    { "type": "header", "content": "Card 2 (Value pack)" },
    { "type": "text", "id": "card2_title", "label": "Title", "default": "Value pack" },
    { "type": "text", "id": "card2_tag", "label": "Corner tag", "default": "Best value" },
    { "type": "textarea", "id": "card2_bullets", "label": "Bullets after the age bullet", "info": "One per line", "default": "Made for homes with two or more little ones\nFree delivery" },
    { "type": "checkbox", "id": "show_gift", "label": "Show free gift bullet", "info": "Waiting on HLT One. Turn on once the gift is agreed.", "default": false },
    { "type": "text", "id": "gift_bullet", "label": "Free gift bullet", "default": "Free gift: Habibara wet wipes (80 sheets) and a 3-pack of Habibara baby wipes, worth S$8.75" },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "select", "id": "background", "label": "Colour combination", "default": "paper", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" }, { "value": "splash-pale", "label": "Splash pale" }
