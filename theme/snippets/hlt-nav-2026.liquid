{{ 'hlt-nav-2026.css' | asset_url | stylesheet_tag }}

{% comment %}
  HLT One header nav (29 Sep 2026 homepage draft), laid out on Bloom's:
  Shop ▾ | Find their snack ▾ | Age bundles.

  - Shop opens a full-width panel. Every top-level item of the header menu
    that has child links becomes a column (Age bundles, Shop by age, Shop by
    snack, Habibara), with a "Not sure where to start?" card at the end.
    Flat top-level links (About, Events) stay out of the desktop bar; the
    mobile drawer still lists them, and the footer carries them too.
  - Find their snack replaces Bloom's quiz: a small panel asking the child's
    age, each answer opening that age's bundle.
  - Age bundles opens the same question in a dialog.

  The three ages default to First Melts, First Bites and Big Crunch (see
  hlt-age-picker). Header settings named hlt_age_1_product, hlt_snack_label,
  hlt_menu_card_image and so on override the defaults if they are added to
  the header schema.

  Hidden on 29 Sep: the header shows the live menu again. To bring this nav
  back, set hlt_use_new_nav to true at the top of snippets/hlt-shop-menu.liquid
  and point the header's menu at 'hlt-header-sep-2026'.

  Usage:
  {% render 'hlt-nav-2026' %}
{% endcomment %}

{%- liquid
  assign shop_menu = section.settings.menu
  assign shop_label = section.settings.hlt_shop_label | default: 'Shop'
  assign snack_label = section.settings.hlt_snack_label | default: 'Find their snack'
  assign bundles_label = section.settings.hlt_bundles_label | default: 'Age bundles'
  assign first_bundle = section.settings.hlt_age_1_product | default: all_products['first-melts-8-months']
  assign bundle_url = first_bundle.url | default: routes.all_products_collection_url
  assign card_image = section.settings.hlt_menu_card_image | default: first_bundle.featured_image
  assign column_count = 0
-%}

<nav class="header__inline-menu hlt-nav" data-hlt-shop-nav aria-label="Main">
  <ul class="list-menu list-menu--inline hlt-nav__list" role="list">
    <li>
      <button
        type="button"
        class="header__menu-item list-menu__item link focus-inset hlt-nav__trigger"
        aria-expanded="false"
        aria-controls="HltShopPanel"
        data-hlt-shop-trigger
      >
        <span>{{ shop_label | escape }}</span>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
    </li>
    <li class="hlt-snack" data-hlt-snack>
      <button
        type="button"
        class="header__menu-item list-menu__item link focus-inset hlt-nav__trigger"
        aria-expanded="false"
        aria-controls="HltSnackPanel"
        data-hlt-snack-trigger
      >
        <span>{{ snack_label | escape }}</span>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
      <div id="HltSnackPanel" class="hlt-snack__panel" data-hlt-snack-panel hidden>
        {% render 'hlt-age-picker', heading_id: 'HltSnackQ' %}
      </div>
    </li>
    <li>
      <a href="{{ bundle_url }}" class="header__menu-item list-menu__item link focus-inset hlt-nav__link" data-hlt-age-open>
        <span>{{ bundles_label | escape }}</span>
      </a>
    </li>
  </ul>

  <div id="HltShopPanel" class="hlt-shop-panel color-{{ section.settings.menu_color_scheme }} gradient" data-hlt-shop-panel hidden>
    <div class="hlt-shop-panel__inner page-width">
      {%- for link in shop_menu.links -%}
        {%- if link.links.size > 0 and column_count < 4 -%}
          {%- assign column_count = column_count | plus: 1 -%}
          <div class="hlt-shop-col">
            <p class="hlt-shop-col__title">
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            </p>
            <ul class="hlt-shop-col__list" role="list">
              {%- for childlink in link.links -%}
                <li>
                  <a href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>{{ childlink.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="hlt-shop-promo">
        <a class="hlt-shop-promo__media" href="{{ bundle_url }}" data-hlt-age-open tabindex="-1" aria-hidden="true">
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '260px', alt: '' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hlt-shop-promo__ph' }}
          {%- endif -%}
        </a>
        <p class="hlt-shop-promo__title">{{ section.settings.hlt_menu_card_heading | default: 'Not sure where to start?' | escape }}</p>
        <a class="button hlt-shop-promo__btn" href="{{ bundle_url }}" data-hlt-age-open>{{ section.settings.hlt_menu_card_button | default: 'Choose their bundle' | escape }}</a>
      </div>
    </div>
  </div>
</nav>


<script>
  (function () {
    var nav = document.querySelector('[data-hlt-shop-nav]');
    if (!nav || nav.hltReady) return;
    nav.hltReady = true;

    var trigger = nav.querySelector('[data-hlt-shop-trigger]');
    var panel = nav.querySelector('[data-hlt-shop-panel]');
    if (!trigger || !panel) return;
    var closeTimer = null;

    function setOpen(on) {
      window.clearTimeout(closeTimer);
      panel.hidden = !on;
      trigger.setAttribute('aria-expanded', on ? 'true' : 'false');
      nav.classList.toggle('is-open', on);
      if (on) document.dispatchEvent(new CustomEvent('hlt:menu-open', { detail: 'shop' }));
    }

    /* A short delay on the way out, so crossing the gap between the trigger and
       the panel does not shut it. */
    function closeSoon() {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(function () { setOpen(false); }, 180);
    }

    trigger.addEventListener('mouseenter', function () { setOpen(true); });
    trigger.addEventListener('click', function () { setOpen(panel.hidden); });
    trigger.parentElement.addEventListener('mouseleave', closeSoon);
    panel.addEventListener('mouseenter', function () { setOpen(true); });
    panel.addEventListener('mouseleave', closeSoon);

    document.addEventListener('hlt:menu-open', function (e) {
      if (e.detail !== 'shop' && !panel.hidden) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });
    ['click', 'focusin'].forEach(function (type) {
      document.addEventListener(type, function (e) {
        if (!panel.hidden && !panel.contains(e.target) && !trigger.contains(e.target)) setOpen(false);
      });
    });
  })();
</script>
