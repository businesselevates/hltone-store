{%- comment -%}
  H08 Habibara (29 Sep 2026 homepage draft), in Bloom's "Drink Bloom" slot.
  Until the IMG-18 scene exists, the wipes pack shows on the Habibara colour.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
  assign pack = section.settings.fallback_product.featured_image
-%}
<section class="hlt hlt--cream hlt-hp hlt-hp-habi{% if img != blank %} hlt-hp-habi--has-image{% endif %}" style="--hlt-hp-habi-bg: {{ section.settings.bg }};">
  <div class="hlt__inner">
    <div class="hlt-hp-habi__grid">
      {%- if img != blank -%}
        <picture class="hlt-hp-habi__bg">
          <source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1170 }} 1170w" sizes="100vw">
          {{ img | image_url: width: 2560 | image_tag: loading: 'lazy', widths: '1100, 1600, 2000, 2560', sizes: '100vw', alt: section.settings.image_alt }}
        </picture>
      {%- endif -%}
      <div class="hlt-hp-habi__text">
        {%- if section.settings.eyebrow != blank -%}<p class="hlt-overline">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="hlt-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="hlt-body">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="hlt-btn-row"><a class="hlt-btn" href="{{ section.settings.button_link | default: '/collections/habibara' }}">{{ section.settings.button_label | escape }}</a></div>
        {%- endif -%}
      </div>
      {%- if img == blank and pack != blank -%}
        <div class="hlt-hp-habi__pack">
          {{ pack | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 380px, 80vw', alt: section.settings.image_alt }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HLT HP: Habibara",
  "tag": "div",
  "class": "hlt-hp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Also from HLT One" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For the mess after snack time." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Habibara baby wipes, from 10-sheet packs for the stroller bag to cartons for the cupboard." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Habibara" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Habibara colour", "default": "#fde8ea" },
    { "type": "image_picker", "id": "image", "label": "Desktop scene (IMG-18)", "info": "2560 x 900. Keep the left half calm; the text sits on it." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile scene", "info": "1170 x 1300." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Habibara baby wipes beside an open snack pack" },
    { "type": "product", "id": "fallback_product", "label": "Fallback product", "info": "Its pack shows until the scene exists." }
  ],
  "presets": [ { "name": "HLT HP: Habibara" } ]
}
{% endschema %}
