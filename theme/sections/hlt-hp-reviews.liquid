{%- comment -%}
  H09 What parents say (29 Sep 2026 homepage draft), in Bloom's customer
  video wall slot. No star ratings or average score until a review app holds
  real reviews. A photo only shows once the reviewer has given written
  permission; without one the card is text only.
{%- endcomment -%}
<section class="hlt hlt--splash-pale hlt-hp hlt-hp-reviews">
  <div class="hlt__inner">
    <div class="hlt-hp-slider" data-hlt-slider>
      <div class="hlt-hp__head">
        <h2 class="hlt-h2">{{ section.settings.heading | escape }}</h2>
        <div class="hlt-hp-arrows">
          <button type="button" class="hlt-hp-arrow" data-hlt-prev aria-label="Previous">{% render 'hlt-icon', name: 'arrow-left', size: 22 %}</button>
          <button type="button" class="hlt-hp-arrow" data-hlt-next aria-label="Next">{% render 'hlt-icon', name: 'arrow-right', size: 22 %}</button>
        </div>
      </div>
      <ul class="hlt-hp-track" data-hlt-track role="list">
        {%- for block in section.blocks -%}
          <li class="hlt-hp-review" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="hlt-hp-review__img">
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 360px, 84vw', alt: block.settings.image_alt }}
              </div>
            {%- endif -%}
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="hlt-hp__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
            <p class="hlt-hp-review__who">{{ block.settings.who | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HLT HP: What parents say",
  "tag": "div",
  "class": "hlt-hp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Parents say their children can't get enough." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "who", "label": "Who and where", "default": "Shopee review" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "800 x 1000. Only with the reviewer's written permission." },
        { "type": "text", "id": "image_alt", "label": "Photo alt text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "HLT HP: What parents say" } ]
}
{% endschema %}
