{%- comment -%}
  H05 Shop by age (29 Sep 2026 homepage draft), in Bloom's shop-by-category
  slot. Two by two on mobile. Until the IMG-13 to IMG-16 photos exist, each tile
  shows its fallback product's pack on Splash Blue.
{%- endcomment -%}
<section class="hlt hlt--cream hlt-hp hlt-hp-tiles-wrap"{% if section.settings.bg_color != blank %} style="background-color: {{ section.settings.bg_color }};"{% endif %}>
  <div class="hlt__inner">
    <div class="hlt-hp__head"><h2 class="hlt-h2">{{ section.settings.heading | escape }}</h2></div>
    <ul class="hlt-hp-tiles" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign pack = false
          if img == blank
            assign img = block.settings.fallback_product.featured_image
            assign pack = true
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="hlt-hp-tile{% if pack %} hlt-hp-tile--pack{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            {%- if img != blank -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 25vw, 50vw', alt: '' }}
            {%- endif -%}
            <span class="hlt-hp-tile__label">
              <b>{{ block.settings.title | escape }}</b>
              {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle | escape }}</span>{%- endif -%}
            </span>
            <span class="hlt-hp-tile__go" aria-hidden="true">{% render 'hlt-icon', name: 'arrow-right', size: 32 %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "HLT HP: Shop by age",
  "tag": "div",
  "class": "hlt-hp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Snacks for the age they are now" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "8 months+" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Melts" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Photo (IMG-13 to IMG-16)", "info": "900 x 1200." },
        { "type": "product", "id": "fallback_product", "label": "Fallback product", "info": "Its pack shows on Splash Blue until the photo exists." }
      ]
    }
  ],
  "presets": [ { "name": "HLT HP: Shop by age" } ]
}
{% endschema %}
